NEXUS_ENVIRONMENT=development
NEXUS_LOG_LEVEL=info
NEXUS_FEATURES=
NEXUS_API_PORT=8787
NEXUS_API_HOST=0.0.0.0
NEXUS_CORS_ORIGINS=http://localhost:5173
NEXUS_AUTH_ISSUER=https://identity.example.com
NEXUS_AUTH_AUDIENCE=nexus-ai-os
NEXUS_AUTH_SECRET=
NEXUS_ENCRYPTION_KEY=

