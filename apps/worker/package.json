  },
  "dependencies": {
    "@nexus/core": "0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.17.0"
  }
}
