{
  "name": "@nexus/brain",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Nexus AI OS Phase 2 Brain Layer: cognition, memory, agents, tools, and orchestration",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nexus/core": "*"
  }
}
